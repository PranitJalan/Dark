[sub_resource type="GDScript" id="GDScript_qr5sa"]
script/source = "extends Area2D





func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		get_tree().get_first_node_in_group(\"level\").coins += 1
		queue_free()
		
"

