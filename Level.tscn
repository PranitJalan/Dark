[sub_resource type="GDScript" id="GDScript_ofirr"]
script/source = "extends StaticBody2D


@onready var sprite_2d: AnimatedSprite2D = $Sprite2D
@export var flip_h = false

var angry = false
var satisfied = false
var player
func _ready() -> void:
	sprite_2d.flip_h = flip_h
var cycle = 0

func _on_area_2d_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Medi\"
		player = body
		var setup : Array
		setup.append([icon, name, self, body])
		setup.append(30)
		if not angry and not satisfied:
			setup.append_array(
				[
					2,
					[false, false, 'Hey please play a game with me'],
					[true, 2, [\"OK\", \"play_game\"], [\"NO\", \"do_not\"]]
				]
			)
		elif satisfied:
			setup.append_array(
				[
					2,
					[false, false, 'Hey'],
					[false, false, \"Thanks Again - sadly i cannot play another game\"]
				]
			)
		elif angry:
			setup.append_array(
				[
					2,
					[false, false, 'GO AWAY - I AM NOT TALKING TO YOU'],
					[false, false, \"YOU WILL REGRET THIS\"]
				]
			)
			
		get._print(setup)

func play_game():
	satisfied = true
	angry = false
	var get = get_tree().get_first_node_in_group(\"dialoge\")
	var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
	var name = \"Medi\"
		
	var setup : Array
	setup.append([icon, name, self, player])
	setup.append(30)
	setup.append_array([
		3,
		[false, false, \"Its, rock, paper, scissors. I always lose it while playing with my big brother\"],
		[false, false, \"ROCK .... PAPER .... SCISSORS .. SHOOT\"],
		[true, 3, [\"ROCK\", 'rock'], [\"PAPER\", 'paper'], [\"SCISSORS\", \"scissors\"]]
	])
	get._print(setup)

func rock():
	if cycle == 0:
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Medi\"
			
		var setup : Array
		setup.append([icon, name, self, player])
		setup.append(30)
		setup.append_array([
			5,
			[false, false, \"SCISSORS\"],
			[false, false, \"Noooo, i lost, wai, lets play one more pleaseee\"],
			[false, true, \"OK\"],
			[false, false, \"ROCK .... PAPER .... SCISSORS .. SHOOT\"],
			[true, 3, [\"ROCK\", 'rock'], [\"PAPER\", 'paper'], [\"SCISSORS\", \"scissors\"]]
		])
		get._print(setup)
		cycle += 1
	else:
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Medi\"
			
		var setup : Array
		setup.append([icon, name, self, player])
		setup.append(30)
		setup.append_array([
			5,
			[false, false, \"PAPER\"],
			[false, false, \"YAYY, I WON\"],
			[false, false, \"YOU MADE MY DAY\"],
			[false, false, \"I WILL LET MY BROTHER KNOW\"],
			[false, false, \"YOU WILL MEET HIM\"]
			])
		get._print(setup)

func paper():
	if cycle == 0:
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Medi\"
			
		var setup : Array
		setup.append([icon, name, self, player])
		setup.append(30)
		setup.append_array([
			5,
			[false, false, \"ROCK\"],
			[false, false, \"Noooo, i lost, wai, lets play one more pleaseee\"],
			[false, true, \"OK\"],
			[false, false, \"ROCK .... PAPER .... SCISSORS .. SHOOT\"],
			[true, 3, [\"ROCK\", 'rock'], [\"PAPER\", 'paper'], [\"SCISSORS\", \"scissors\"]]
		])
		get._print(setup)
		cycle += 1
	else:
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Medi\"
			
		var setup : Array
		setup.append([icon, name, self, player])
