[sub_resource type="GDScript" id="GDScript_qr5sa"]
script/source = "extends StaticBody2D


@onready var sprite_2d: AnimatedSprite2D = $Sprite2D
@export var flip_h = false





var brotheri = \"unclear\"
var player




func _ready() -> void:
	sprite_2d.flip_h = flip_h


func _on_area_2d_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Santi\"
		player = body
		var setup : Array
		setup.append([icon, name, self, body])
		setup.append(30)
		var brother = get_tree().get_first_node_in_group(\"brother\")
		if brother.angry:
			setup.append_array([
				5,
				[false, false, \"What do you want?\"],
				[false, true, \"Meet Mr.Doctor\"],
				[false, false, \"I heard you angered my little brother, you are not going to the doctor\"],
				[false, false, \"YOU ARE GOING TO HELL\"],
				[true, 2, [\"Please sorry no--\", \"backdoor\"], [\"You will regret this\", \"backdoor\"]]
			])
		elif brother.satisfied:
			setup.append_array([
				5,
				[false, false, \"What do you want?\"],
				[false, true, \"Meet Mr.Doctor\"],
				[false, false, \"I heard you played with my little brother, hes very happy with you\"],
				[false, false, \"I will send you to his city\"],
				[true, 1, [\"Thank You\", \"send\"]]
				
			])
		else:
			setup.append_array([
				4,
				[false, false, \"Hey\"],
				[false, false, \"Didnt you meet my brother yet\"],
				[false, false, \"Hes eager for visitor\"],
				[false, false, \"Go meet him first\"]
			])
		get._print(setup)

func backdoor():
	var get = get_tree().get_first_node_in_group(\"dialoge\")
	var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
	var name = \"Santi\"
		
	var setup : Array
	setup.append([icon, name, self, player])
	setup.append(30)
	setup.append_array([
		2,
		[false, false, \"I DONT CARE\"],
		[false, false, \"BYE BYE\"]
	])
	await get._print(setup)
	get_tree().get_first_node_in_group(\"level\")._change_scene(\"backdoor\")

func send():
	var get = get_tree().get_first_node_in_group(\"dialoge\")
	var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
	var name = \"Santi\"
		
	var setup : Array
	setup.append([icon, name, self, player])
	setup.append(30)
	setup.append_array([
		2,
		[false, false, \"No need\"],
		[false, false, \"Bye Bye\"]
	])
	await get._print(setup)
	get_tree().get_first_node_in_group(\"level\")._change_scene(\"doctor\")
"

[sub_resource type="GDScript" id="GDScript_afmmk"]
script/source = "extends StaticBody2D


@onready var sprite_2d: AnimatedSprite2D = $Sprite2D
@export var flip_h = false
var player 
func _ready() -> void:
	sprite_2d.flip_h = flip_h


func _on_area_2d_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		var get = get_tree().get_first_node_in_group(\"dialoge\")
		var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
		var name = \"Jackson\"
		player = body
		var setup : Array
		setup.append([icon, name, self, body])
		setup.append(30)
		setup.append_array([
			7,
			[false, false, \"Howdy dear, another one stuck down there\"],
			[false, false, \"was it tht crazy Santi that sent you here\"],
			[false, false, \"Do you want to meet Mr.Doctor?\"],
			[false, true, \"Yes\"],
			[false, false, \"Well normally there is no way out of here\"],
			[false, false, \"But for you my dear, give me 10 coins and I will make a way out\"],
			[true, 2, [\"Please, take it\", \"get_out\"], [\"I am not paying anything\", \"stuck\"]]
		])
		get._print(setup)

func get_out():
	var get = get_tree().get_first_node_in_group(\"dialoge\")
	var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
	var name = \"GREEN GUY\"
	var level = get_tree().get_first_node_in_group(\"level\")
	var setup : Array
	setup.append([icon, name, self, player])
	setup.append(30)
	if level.coins < 10:
		setup.append_array([
			3,
			[false, false, \"Looks like you dont have enough\"],
			[false, false, \"You are stuck here forever\"],
			[false, false, \"HAHAH\"]
		])
	else:
		setup.append_array([
			2,
			[false, false, \"You are lucky you met me here\"],
			[false, false, \"Bye Bye\"]
		])
	await get._print(setup)
	if level.coins  >= 10:
		level.coins -= 5
		level._change_scene(\"doctor\")

func stuck():
	var get = get_tree().get_first_node_in_group(\"dialoge\")
	var icon = sprite_2d.sprite_frames.get_frame_texture(\"default\", 0)
	var name = \"GREEN GUY\"
	var level = get_tree().get_first_node_in_group(\"level\")
	var setup : Array
	setup.append([icon, name, self, player])
	setup.append(30)
	setup.append_array([
		3,
		[false, false, \"I guess you want to be stuck here forever\"],
		[false, false, \"Though I am generous\"],
		[false, false, \"When you change your mind, I am right here\"]
	])
	get._print(setup)
"

